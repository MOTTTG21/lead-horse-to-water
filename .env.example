# Copy to .env and fill in real values. .env is gitignored -- never commit
# real secrets. In production these come from GCP Secret Manager instead
# (see docs/design-plan.md, "Stack").

ANTHROPIC_API_KEY=your-key-here

# Optional: leave all three unset to use stub identity (every visitor is
# guest, no login required). Set all three to require real Auth0 login.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
SESSION_SECRET_KEY=generate-a-random-secret-e.g.-python3-c-import-secrets-print-secrets.token_hex(32)

# Optional: comma-separated, case-insensitive. Leave empty (or unset) to
# let anyone who completes Auth0 login play. Set this to restrict the
# game to specific people -- anyone else's login succeeds at Auth0 but
# gets a "this game is private" page instead of a session.
ALLOWED_EMAILS=you@example.com
